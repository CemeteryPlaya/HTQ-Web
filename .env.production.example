# ═══════════════════════════════════════════════════════════════════════════
#  HTQWeb — PRODUCTION .env  (current single-Django stack)
#  Copy to .env, fill the REQUIRED block, then: docker compose up -d --build
#  (edge TLS/nginx:  docker compose --profile production up -d --build)
#
#  Keys with a compose default are marked [has default]; everything in the
#  REQUIRED block below MUST be changed from its default for a real deploy.
# ═══════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────
#  REQUIRED — the deploy is insecure or broken until these are set
# ─────────────────────────────────────────────────────────────────────────

# Django secrets. Generate each with:  openssl rand -hex 32
DJANGO_SECRET_KEY=CHANGE-ME-random-64-hex
# JWT_SECRET is shared: Django issues tokens with it AND the SFU validates
# video signaling with the SAME secret. Get it wrong → nothing authenticates
# and video dies silently. One value, everywhere.
JWT_SECRET=CHANGE-ME-random-64-hex
JWT_ISSUER=htqweb-auth

# External Postgres (prod DB is NOT in this compose file — it lives elsewhere).
DB_HOST=45.10.110.212
DB_PORT=5432
DB_NAME=htqweb
DB_USER=htqweb
DB_PASSWORD=CHANGE-ME

# Schema management on boot (only backend-web acts on these):
#   RUN_MIGRATIONS=1  applies migrations — REQUIRED on first boot to create the
#                     schema. On an already-migrated prod DB people keep it 0.
#   RUN_BOOTSTRAP=1   collectstatic + create S3 buckets + seed admin/admin12345.
RUN_MIGRATIONS=1
RUN_BOOTSTRAP=1

# Object storage (MinIO in-stack). These credentials double as the S3 keys.
MINIO_ROOT_USER=CHANGE-ME
MINIO_ROOT_PASSWORD=CHANGE-ME
# Browser-reachable base URL for presigned download links. MUST be reachable
# from users' browsers — the localhost default breaks every attachment/avatar
# for remote users. In prod point it at your domain (routed to MinIO) or a
# public object-storage endpoint.
S3_PUBLIC_ENDPOINT=https://your-domain.com
MINIO_CONSOLE_URL=https://your-domain.com:9001

# Grafana admin login (/grafana/).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE-ME

# Domain for nginx + Let's Encrypt (used by the `production` profile; see the
# certbot quickstart in docker-compose.yml header).
SERVER_DOMAIN=your-domain.com

# ─────────────────────────────────────────────────────────────────────────
#  CONFERENCE / WebRTC — required for video to WORK (not just start)
# ─────────────────────────────────────────────────────────────────────────

# Public IP of this host. MANDATORY: with wildcard listen + empty announced
# the SFU crashes on start on purpose (otherwise clients get SDP 0.0.0.0 =
# black video). Must be the IP users' browsers can actually reach.
WEBRTC_ANNOUNCED_IP=
WEBRTC_SERVER_PORT=44444        # [has default] open UDP+TCP on the firewall
MEDIASOUP_WORKERS=1             # [has default] bump toward vCPU count for heavy calls

SFU_REQUIRE_AUTH=true           # [has default] keep true in prod
SFU_REQUIRE_TLS=false           # [has default] TLS terminates at nginx — leave false
# Origin check: set DISABLE=false AND list your origins to lock signaling down.
SFU_DISABLE_ORIGIN_CHECK=true
SFU_ALLOWED_ORIGINS=            # e.g. https://your-domain.com

# TURN relay — CRITICAL for users on mobile/strict-NAT networks. Without it,
# participants on different networks behind symmetric NAT get a black screen
# even though same-network calls work. Use coturn or a paid provider.
TURN_URLS=                      # turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349
TURN_USERNAME=
TURN_CREDENTIAL=

# QUIC/WebTransport bridge (UDP :4433, bypasses nginx). Empty = not announced,
# frontend stays on WebSocket. Prod: https://your-domain.com:4433/sfu
CONFERENCE_WT_URL=
CONFERENCE_SFU_URL=             # [has default] empty = same-origin ws(s)://<host>/ws/sfu/

# ─────────────────────────────────────────────────────────────────────────
#  CORPORATE MAIL (apps/mail) — OPTIONAL, wire up later
#  Leave blank to ship without mail: mailboxes exist only as DB rows and the
#  UI shows an honest "server not connected" banner. `manage.py mail_check`
#  diagnoses this whole chain when you do connect it.
# ─────────────────────────────────────────────────────────────────────────
CORPORATE_MAIL_DOMAIN=          # bare domain, no @ / https:// / trailing slash
MAILCOW_DOMAIN=                 # defaults to CORPORATE_MAIL_DOMAIN if empty
MAILCOW_DEFAULT_QUOTA_MB=1024
MAIL_PROVISIONER=auto           # auto | mailcow | imap | none

# Option A — Mailcow REST API (full create/archive/delete of mailboxes):
MAILCOW_API_URL=                # https://mail.example.com/api/v1  (no trailing slash)
MAILCOW_API_KEY=

# Option B — plain IMAP/SMTP server (direct, or via the mail-tunnel profile):
IMAP_HOST=
IMAP_PORT=993
IMAP_SSL=true
IMAP_STARTTLS=false
IMAP_TLS_SERVER_HOSTNAME=
SMTP_HOST=
SMTP_PORT=587
SMTP_SSL=false
SMTP_STARTTLS=true

MAIL_SYNC_FOLDERS=INBOX,Sent
MAIL_SYNC_MAX_MESSAGES=200
MAIL_SYNC_PUSH_FLAGS=true
MAIL_RECONCILE_AUTO_APPLY=false

# SSH tunnel to a mail server closed to the outside (profile: mail-tunnel).
# Prep: key → infra/mail-tunnel/ssh/id_ed25519 ; ssh-keyscan → known_hosts.
# Then point the backend at it: IMAP_HOST=mail-tunnel IMAP_PORT=1143 IMAP_SSL=false
MAIL_TUNNEL_SSH_HOST=
MAIL_TUNNEL_SSH_PORT=22
MAIL_TUNNEL_SSH_USER=
MAIL_TUNNEL_REMOTE_IMAP_HOST=127.0.0.1
MAIL_TUNNEL_REMOTE_IMAP_PORT=993
MAIL_TUNNEL_REMOTE_SMTP_HOST=
MAIL_TUNNEL_REMOTE_SMTP_PORT=587
MAIL_TUNNEL_LOCAL_IMAP_PORT=1143
MAIL_TUNNEL_LOCAL_SMTP_PORT=1587

# ─────────────────────────────────────────────────────────────────────────
#  BUILD-TIME PROXY (only if your Docker network MITM-intercepts TLS)
#  Your containers sit behind a Falcongaze intercepting proxy: npm/apk inside
#  image builds need its CA trusted, or builds fail at the download step.
# ─────────────────────────────────────────────────────────────────────────
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=
