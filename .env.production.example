# ═══════════════════════════════════════════════════════════════════════════
#  HTQWeb — PRODUCTION .env template (current single-Django stack)
#  Copy to .env, fill the REQUIRED block, then: docker compose up -d --build
#  (edge TLS/nginx:  docker compose --profile production up -d --build)
#
#  Keys with a compose default are marked [has default]; everything in the
#  REQUIRED block below MUST be changed from its default for a real deploy.
# ═══════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────
#  REQUIRED — the deploy is insecure or broken until these are set
# ─────────────────────────────────────────────────────────────────────────

# Django secrets. Generate each with:  openssl rand -hex 32
DJANGO_SECRET_KEY=CHANGE-ME-random-64-hex
# JWT_SECRET is shared: Django issues tokens with it AND the SFU validates
# video signaling with the SAME secret. One value, everywhere.
JWT_SECRET=CHANGE-ME-random-64-hex
JWT_ISSUER=htqweb-auth

# Postgres. If you run the DB in-stack (db service), set DB_HOST=db and the
# password below becomes the new DB's password on first boot. If the DB is
# external, point DB_HOST at it and rotate its password separately.
DB_HOST=db
DB_PORT=5432
DB_NAME=htqweb
DB_USER=htqweb
DB_PASSWORD=CHANGE-ME

# Schema management on boot (only backend-web acts on these):
#   RUN_MIGRATIONS=1  applies migrations — REQUIRED on first boot to create the
#                     schema. On an already-migrated DB keep it 0.
#   RUN_BOOTSTRAP=1   collectstatic + create S3 buckets + seed admin/admin12345.
RUN_MIGRATIONS=1
RUN_BOOTSTRAP=1

# Object storage (MinIO in-stack). These credentials double as the S3 keys.
MINIO_ROOT_USER=CHANGE-ME
MINIO_ROOT_PASSWORD=CHANGE-ME
# Browser-reachable base URL for presigned download links. MUST be reachable
# from users' browsers — the localhost default breaks attachments for remote
# users. In prod point it at your domain (routed to MinIO).
S3_PUBLIC_ENDPOINT=https://your-domain.com
MINIO_CONSOLE_URL=https://your-domain.com:9001

# Grafana admin login (/grafana/).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE-ME

# Domain for nginx + Let's Encrypt (production profile).
SERVER_DOMAIN=your-domain.com

# ─────────────────────────────────────────────────────────────────────────
#  CORPORATE TLS INTERCEPTION (Falcongaze / Palo Alto) — build-time only
#  If your Docker build network MITM-intercepts TLS, pip/npm/apt fail the
#  certificate check. Feed the intercepting CA in here and the Dockerfiles
#  install + trust it during the build. Leave BLANK on a normal network —
#  the build then runs exactly as before (the step is skipped).
#
#  How to fill it (base64 of the CA cert, single line, no newlines):
#     Linux/WSL :  base64 -w0 Falcongaze.crt
#     macOS     :  base64 -b0 Falcongaze.crt
#     PowerShell:  [Convert]::ToBase64String([IO.File]::ReadAllBytes("Falcongaze.crt"))
#  Paste the output as CORPORATE_CA_BASE64 (one long line).
# ─────────────────────────────────────────────────────────────────────────
CORPORATE_CA_BASE64=

# ─────────────────────────────────────────────────────────────────────────
#  CONFERENCE / WebRTC — ONLY if you use video. Skip entirely for a
#  documents-and-buttons deploy (don't start sfu/webtransport, and run
#  `manage.py service conference --off` so the UI hides the call button).
# ─────────────────────────────────────────────────────────────────────────
# Public IP of this host. MANDATORY if the SFU runs: with wildcard listen +
# empty announced the SFU crashes on start on purpose.
WEBRTC_ANNOUNCED_IP=
WEBRTC_SERVER_PORT=44444         # [has default] open UDP+TCP on the firewall
MEDIASOUP_WORKERS=1              # [has default]
SFU_REQUIRE_AUTH=true            # [has default] keep true in prod
SFU_REQUIRE_TLS=false            # [has default] TLS terminates at nginx
SFU_DISABLE_ORIGIN_CHECK=true
SFU_ALLOWED_ORIGINS=             # e.g. https://your-domain.com
# TURN relay — CRITICAL for users on mobile/strict-NAT networks if video is on.
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
CONFERENCE_WT_URL=               # QUIC bridge; empty = WebSocket only
CONFERENCE_SFU_URL=              # [has default] empty = same-origin ws(s)://<host>/ws/sfu/

# ─────────────────────────────────────────────────────────────────────────
#  CORPORATE MAIL (apps/mail) — OPTIONAL, wire up later.
#  Blank = mailboxes exist only as DB rows; UI shows a "server not connected"
#  banner. `manage.py mail_check` diagnoses the whole chain once connected.
# ─────────────────────────────────────────────────────────────────────────
CORPORATE_MAIL_DOMAIN=           # bare domain, no @ / https:// / trailing slash
MAILCOW_DOMAIN=                  # defaults to CORPORATE_MAIL_DOMAIN if empty
MAILCOW_DEFAULT_QUOTA_MB=1024
MAIL_PROVISIONER=auto            # auto | mailcow | imap | none
# Option A — Mailcow REST API:
MAILCOW_API_URL=                 # https://mail.example.com/api/v1  (no trailing slash)
MAILCOW_API_KEY=
# Option B — plain IMAP/SMTP (direct, or via the mail-tunnel profile):
IMAP_HOST=
IMAP_PORT=993
IMAP_SSL=true
IMAP_STARTTLS=false
IMAP_TLS_SERVER_HOSTNAME=
SMTP_HOST=
SMTP_PORT=587
SMTP_SSL=false
SMTP_STARTTLS=true
MAIL_SYNC_FOLDERS=INBOX,Sent
MAIL_SYNC_MAX_MESSAGES=200
MAIL_SYNC_PUSH_FLAGS=true
MAIL_RECONCILE_AUTO_APPLY=false
# SSH tunnel to a mail server closed to the outside (profile: mail-tunnel):
MAIL_TUNNEL_SSH_HOST=
MAIL_TUNNEL_SSH_PORT=22
MAIL_TUNNEL_SSH_USER=
MAIL_TUNNEL_REMOTE_IMAP_HOST=127.0.0.1
MAIL_TUNNEL_REMOTE_IMAP_PORT=993
MAIL_TUNNEL_REMOTE_SMTP_HOST=
MAIL_TUNNEL_REMOTE_SMTP_PORT=587
MAIL_TUNNEL_LOCAL_IMAP_PORT=1143
MAIL_TUNNEL_LOCAL_SMTP_PORT=1587

# ─────────────────────────────────────────────────────────────────────────
#  Optional build-time outbound proxy (separate from the CA above).
# ─────────────────────────────────────────────────────────────────────────
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=
