# Copy to .env.development.local and adjust if the backend runs on non-default
# ports. Vite dev server proxies /api/* and /ws/* to these targets — mirrors
# nginx upstream routing.

# One Django backend, two processes (see .env.example for the full list):
#   :8000 gunicorn/WSGI — /api/*, /django-admin/, static
#   :8001 uvicorn/ASGI  — SSE /api/requests/v1/stream + /ws/* (messenger socket.io)
VITE_BACKEND_TARGET=http://127.0.0.1:8000
VITE_ASGI_TARGET=http://127.0.0.1:8001
VITE_MESSENGER_WS_TARGET=ws://127.0.0.1:8001

# SFU (mediasoup signaling)
VITE_SFU_WS_TARGET=ws://127.0.0.1:4443

# Set to false to force HTTP (faster dev start without cert lookup)
VITE_DEV_HTTPS=false
