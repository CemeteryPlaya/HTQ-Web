# ╔═══════════════════════════════════════════════════════════════════════════╗
# ║  Root .env.example — multi-service infra secrets only.                    ║
# ║  Docker Compose interpolates ${VAR} from .env into each service's         ║
# ║  `environment:` block. Service-specific secrets live in services/<n>/.env.║
# ║  Copy to .env and fill in real values.                                    ║
# ╚═══════════════════════════════════════════════════════════════════════════╝

# ─── Database (shared Postgres + PgBouncer; one schema per service) ─────────
DB_NAME=htqweb
DB_USER=htqweb
DB_PASSWORD=change-me
DB_HOST=db
DB_PORT=5432
# Host port used to expose Docker Postgres for local processes outside Docker
DB_HOST_PORT=55432

# ─── JWT (signed by user-service, validated by every other service) ─────────
# Must match across all services. user-service is the issuer.
JWT_SECRET=change-me-to-a-random-256-bit-secret

# ─── Service-to-service JWT (user-service → media-service for avatars, …) ──
SERVICE_JWT_SECRET=change-me-to-another-random-256-bit-secret

# ─── Object storage (S3 / MinIO) ────────────────────────────────────────────
# Manifesto: ONE microservice = ONE bucket. Adding a new storage-owning
# service? Add a new bucket here, propagate it via docker-compose.yml, and
# document the prefix layout in services/README.md (#object-storage).
#
# Dev defaults point at the MinIO container shipped in docker-compose.dev.yml.
# In production: replace S3_ENDPOINT with the real provider (AWS S3, Yandex
# Object Storage, etc.), set S3_USE_PATH_STYLE=false for AWS, and rotate
# S3_ACCESS_KEY / S3_SECRET_KEY out of dev defaults.
STORAGE_BACKEND=s3
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_USE_PATH_STYLE=true

# MinIO root login (= S3 keys above, so the existing dev volume stays valid)
# and web console URL surfaced in the admin panel.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_CONSOLE_URL=http://localhost:9001

# Per-service buckets — bootstrapped automatically by `minio-bootstrap` in
# docker-compose.dev.yml. In prod create them in your provider console first.
MEDIA_S3_BUCKET=htqweb-media
MESSENGER_S3_BUCKET=htqweb-messenger
CMS_S3_BUCKET=htqweb-cms
CONFERENCES_S3_BUCKET=htqweb-conferences

# HMAC secrets for short-lived signed URLs (used inside <img src> /
# <a download>). Rotate independently from JWT_SECRET.
ATTACHMENT_SIGNED_URL_SECRET=change-me-attachment-signed-secret
NEWS_SIGNED_URL_SECRET=change-me-news-signed-secret

# ─── MongoDB (HR documents NoSQL storage) ───────────────────────────────────
MONGO_USER=htqweb
MONGO_PASSWORD=change-me-mongo

# ─── AdminJS Panel ──────────────────────────────────────────────────────────
ADMINJS_EMAIL=admin@htq.local
ADMINJS_PASSWORD=admin

# ─── Where service-specific secrets live ────────────────────────────────────
# OAuth / Gmail / encryption  → services/email/.env       (.env.example shipped)
# Push notifications (FCM)    → services/messenger/.env   (.env.example shipped)
# S3 storage credentials      → services/media/.env       (.env.example shipped)
# WebRTC / SFU bitrates       → sfu/.env                  (.env.example shipped)
# Vite / frontend dev vars    → frontend/.env             (.env.example shipped)
