# ╔═══════════════════════════════════════════════════════════════════════════╗
# ║  Root .env.example — multi-service infra secrets only.                    ║
# ║  Docker Compose interpolates ${VAR} from .env into each service's         ║
# ║  `environment:` block. Service-specific secrets live in services/<n>/.env.║
# ║  Copy to .env and fill in real values.                                    ║
# ╚═══════════════════════════════════════════════════════════════════════════╝

# ─── Среда и политика fallback'ов ───────────────────────────────────────────
# Одна ось на все три рантайма: Django, фронт (VITE_HTQ_ENV) и SFU.
#
#   production  — прод;
#   staging     — тестовая среда; код ведёт себя РОВНО как на проде
#                 (docker compose -f docker-compose.yml -f docker-compose.staging.yml);
#   development — машина разработчика (docker-compose.dev.yml ставит её сам).
#
# Что это меняет. Fallback — место, где вместо настоящего значения
# подставляется запасное (htqweb/fallback.py, frontend/src/lib/fallback.ts,
# sfu/src/fallback.ts). На проде и стейдже подмена происходит и пользователю
# не видна, но пишет строку «FALLBACK …» в лог и растит htqweb_fallback_total.
# У разработчика подмен НЕТ вовсе: летит FallbackNotAllowed, чтобы была видна
# настоящая причина, а не её замаскированное следствие.
HTQ_ENV=production

# Публичный адрес платформы — им собираются ссылки в письмах и сообщениях
# (например, приглашения в видеоконференцию). Задать ОБЯЗАТЕЛЬНО, если стенд
# стоит за прокси: сам бэкенд видит в Host внутреннее имя контейнера, и
# ссылка вида http://backend-web:8000/join/... не откроется ни у кого.
PUBLIC_BASE_URL=https://your-domain.com

# Перебивает вывод режима из среды: strict | log. Пустое значение = «выведи
# из HTQ_ENV». Нужно, чтобы включить строгий режим на стенде перед выкаткой
#   FALLBACK_MODE=strict docker compose -f docker-compose.yml \
#       -f docker-compose.staging.yml up -d
# или наоборот — разово ослабить его локально, когда чинишь что-то другое.
FALLBACK_MODE=

# Уровень логгера htqweb.fallback. Подмены пишутся отдельно от остальных
# логов: WARNING — то, у чего есть настоящая причина, INFO — предусмотренные
# деградации. Поставьте WARNING, чтобы видеть только первые.
FALLBACK_LOG_LEVEL=INFO

# ─── Database (shared Postgres + PgBouncer; one schema per service) ─────────
DB_NAME=htqweb
DB_USER=htqweb
DB_PASSWORD=change-me
DB_HOST=db
DB_PORT=5432
# Host port used to expose Docker Postgres for local processes outside Docker
DB_HOST_PORT=55432

# ─── JWT (signed by user-service, validated by every other service) ─────────
# Must match across all services. user-service is the issuer.
JWT_SECRET=change-me-to-a-random-256-bit-secret

# ─── Service-to-service JWT (user-service → media-service for avatars, …) ──
SERVICE_JWT_SECRET=change-me-to-another-random-256-bit-secret

# ─── Object storage (S3 / MinIO) ────────────────────────────────────────────
# Manifesto: ONE microservice = ONE bucket. Adding a new storage-owning
# service? Add a new bucket here, propagate it via docker-compose.yml, and
# document the prefix layout in services/README.md (#object-storage).
#
# Dev defaults point at the MinIO container shipped in docker-compose.dev.yml.
# In production: replace S3_ENDPOINT with the real provider (AWS S3, Yandex
# Object Storage, etc.), set S3_USE_PATH_STYLE=false for AWS, and rotate
# S3_ACCESS_KEY / S3_SECRET_KEY out of dev defaults.
STORAGE_BACKEND=s3
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_USE_PATH_STYLE=true

# MinIO root login (= S3 keys above, so the existing dev volume stays valid)
# and web console URL surfaced in the admin panel.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_CONSOLE_URL=http://localhost:9001

# Per-service buckets — bootstrapped automatically by `minio-bootstrap` in
# docker-compose.dev.yml. In prod create them in your provider console first.
MEDIA_S3_BUCKET=htqweb-media
MESSENGER_S3_BUCKET=htqweb-messenger
CMS_S3_BUCKET=htqweb-cms
CONFERENCES_S3_BUCKET=htqweb-conferences

# HMAC secrets for short-lived signed URLs (used inside <img src> /
# <a download>). Rotate independently from JWT_SECRET.
ATTACHMENT_SIGNED_URL_SECRET=change-me-attachment-signed-secret
NEWS_SIGNED_URL_SECRET=change-me-news-signed-secret

# ─── MongoDB (HR documents NoSQL storage) ───────────────────────────────────
MONGO_USER=htqweb
MONGO_PASSWORD=change-me-mongo

# ─── AdminJS Panel ──────────────────────────────────────────────────────────
ADMINJS_EMAIL=admin@htq.local
ADMINJS_PASSWORD=admin

# ─── Конференция: SFU + QUIC-мост ───────────────────────────────────────────
# Публичный IP, который SFU кладёт в ICE-кандидаты. ОБЯЗАТЕЛЕН в проде:
# с wildcard listenIp и пустым announced контейнер намеренно падает на
# старте (иначе клиенты получают SDP с 0.0.0.0 и чёрное видео).
# В dev подставляется 127.0.0.1 — годится, пока браузер на той же машине.
WEBRTC_ANNOUNCED_IP=
WEBRTC_SERVER_PORT=44444
# Сигналинг требует платформенный JWT (тот же JWT_SECRET, что у Django).
# false — только для локальной отладки без бэкенда.
SFU_REQUIRE_AUTH=true
# TLS терминирует nginx, внутрь контейнера идёт ws:// — оставьте false.
SFU_REQUIRE_TLS=false
# Проверка Origin. При включении (false) задайте список:
# SFU_ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com
SFU_DISABLE_ORIGIN_CHECK=true
SFU_ALLOWED_ORIGINS=
# QUIC-сигналинг (webtransport, UDP :4433 — мимо nginx). Пусто = не
# анонсируем мост, фронт работает по WebSocket. В проде: https://<домен>:4433/sfu
# плюс живой сертификат домена:
# WT_CERT_FILE=/etc/letsencrypt/live/<домен>/fullchain.pem
# WT_KEY_FILE=/etc/letsencrypt/live/<домен>/privkey.pem
CONFERENCE_WT_URL=
# ── TURN — КРИТИЧНО для работы через интернет ───────────────────────────────
# STUN (два публичных выше зашиты в настройках) лишь сообщает клиенту его
# внешний адрес. Когда обе стороны за СИММЕТРИЧНЫМ NAT — мобильный интернет,
# корпоративные сети со строгим firewall — прямой путь для медиа не находится,
# и связь между РАЗНЫМИ сетями не устанавливается, хотя внутри одной работает.
# Это и есть «у части участников чёрный экран». Лечится только TURN.
#
# Свой coturn или платный (Twilio, Metered, Xirsys). Через запятую:
# TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# ─── Запись, история и протокол конференций (apps/conference) ───────────────
# Запись серверная и ведётся АВТОМАТИЧЕСКИ на каждой встрече. Как это
# устроено: SFU вешает на каждую дорожку каждого участника PlainTransport и
# ремуксит поток ffmpeg'ом (-c copy, без перекодирования) в общий том;
# контейнер backend-media-worker потом сводит дорожки в одно mp4 и распознаёт
# речь локальным Whisper. Аудио никуда не уходит за периметр.
#
# ⚠️ ОБЯЗАТЕЛЬНО задать: общий секрет канала SFU → Django. Пока он пуст,
# приём фактов о встречах ЗАКРЫТ (а не открыт всем — так задумано), то есть
# ни истории, ни записей не будет вообще. Любая длинная случайная строка:
#   openssl rand -hex 32
CONFERENCE_INTERNAL_TOKEN=
# Сколько дней живёт МЕДИА встречи. По истечении срока видео и аудио
# удаляются из хранилища безвозвратно; строка в истории и текстовый протокол
# остаются навсегда. Уборку делает Celery-beat раз в сутки.
CONFERENCE_RETENTION_DAYS=25
# false — не писать вообще (встречи всё равно попадут в историю).
CONFERENCE_RECORDING_ENABLED=true
# Сколько участников помещается в картинку сведённого видео. Остальные в
# кадр не попадают, но их речь есть и в звуке, и в протоколе.
CONFERENCE_MAX_TILES=9
# Пусто = записи лежат в MEDIA_S3_BUCKET под префиксом conference/. Отдельное
# имя нужно, только если для записей заводят свою политику жизни в S3.
CONFERENCE_S3_BUCKET=
# Через сколько часов считать незакрытую встречу брошенной (SFU перезапустился
# посреди звонка и не прислал finish) и закрыть её принудительно.
CONFERENCE_ORPHAN_HOURS=6
# Модель распознавания. medium — рабочий компромисс: русский держит уверенно,
# часовая встреча на CPU считается 20–40 минут фоном, весов ~1.5 ГБ.
# small — втрое быстрее и заметно хуже на терминах, фамилиях и числах.
# large-v3 — точнее всех, но на CPU непрактичен: нужна видеокарта
# (тогда WHISPER_DEVICE=cuda и WHISPER_COMPUTE_TYPE=float16).
WHISPER_MODEL=medium
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=ru
# Диапазон UDP-портов, на которые SFU шлёт RTP локальному ffmpeg. Наружу не
# публикуется; трогать нужно, только если диапазон занят чем-то ещё.
RECORDER_RTP_PORT_MIN=45000
RECORDER_RTP_PORT_MAX=45999

# ─── Корпоративная почта (apps/mail) ────────────────────────────────────────
# Пока не заполнено — почтовый сервер НЕ подключён: ящик, созданный на сайте,
# останется только строкой в базе платформы. Раздел «Корпоративные ящики»
# честно предупреждает об этом баннером.
#
# Домен, в котором живут ящики (i.ivanov@<домен>). Без него POST
# /api/email/v1/mailboxes/ отвечает 500 "MAILCOW_DOMAIN not configured" —
# это и есть «невозможно добавить почтовый ящик».
#
# ГОЛЫЙ домен, без «@», без «https://», без пробела после «=»:
#   верно:    CORPORATE_MAIL_DOMAIN=htq.group
#   неверно:  @htq.group   https://mail.htq.group/   i.ivanov@htq.group
# Адрес веб-панели/API — это ДРУГАЯ переменная, MAILCOW_API_URL ниже.
# (Опечатки такого рода бэкенд чинит сам и пишет предупреждение в лог, но
# лучше задать сразу правильно — «mail.htq.group» и «htq.group» это разные
# домены, и угадать за вас он не может.)
CORPORATE_MAIL_DOMAIN=
# Историческое имя того же домена; если пусто — берётся CORPORATE_MAIL_DOMAIN.
MAILCOW_DOMAIN=
MAILCOW_DEFAULT_QUOTA_MB=1024

# Кто заводит ящики на сервере: auto | mailcow | imap | none
#   auto    — mailcow, если задан MAILCOW_API_URL+KEY; иначе imap, если задан
#             IMAP_HOST; иначе none (ничего наружу не вызывается).
#   mailcow — REST API Mailcow: ящик реально создаётся/архивируется/удаляется.
#   imap    — сервер без админ-API: ящик обязан существовать, платформа
#             проверяет учётку живым IMAP-логином и привязывает его.
#   none    — только локальная строка.
MAIL_PROVISIONER=auto

# ── Вариант A: Mailcow с REST API ──
# URL — с путём до API, БЕЗ завершающего слеша: https://mail.example.com/api/v1
# Ключ создаётся в панели Mailcow: Configuration → Access → API (нужен
# read-write; read-only хватит только на сверку, но не на создание ящиков).
MAILCOW_API_URL=
MAILCOW_API_KEY=

# ── Вариант B: свой почтовый сервер по IMAP/SMTP ──
# Напрямую по сети:
#   IMAP_HOST=mail.company.ru   IMAP_PORT=993   IMAP_SSL=true
#   SMTP_HOST=mail.company.ru   SMTP_PORT=587   SMTP_STARTTLS=true
# Через SSH-туннель (см. профиль mail-tunnel ниже) — шифрует сам SSH:
#   IMAP_HOST=mail-tunnel       IMAP_PORT=1143  IMAP_SSL=false
#   SMTP_HOST=mail-tunnel       SMTP_PORT=1587  SMTP_STARTTLS=false
IMAP_HOST=
IMAP_PORT=993
IMAP_SSL=true
IMAP_STARTTLS=false
# Нужно, только если хотите TLS ВНУТРИ туннеля: подключаемся к mail-tunnel, а
# сертификат проверяем по настоящему имени сервера.
IMAP_TLS_SERVER_HOSTNAME=
SMTP_HOST=
SMTP_PORT=587
SMTP_SSL=false
SMTP_STARTTLS=true

# Синхронизация писем. MAIL_SYNC_PUSH_FLAGS=true — прочитанное в платформе
# помечается \Seen и на сервере (вторая половина двусторонней синхронизации).
MAIL_SYNC_FOLDERS=INBOX,Sent
MAIL_SYNC_MAX_MESSAGES=200
MAIL_SYNC_PUSH_FLAGS=true
# Ежечасная сверка ящиков по умолчанию только пишет расхождения в лог;
# применяет их админ из UI. true = сводить автоматически (в обе стороны):
# импортировать чужие ящики И создавать недостающие на сервере.
MAIL_RECONCILE_AUTO_APPLY=false
# Привязка БЕСХОЗНЫХ ящиков к владельцам по точному совпадению адреса с email
# пользователя. Разрешение ОТДЕЛЬНОЕ от AUTO_APPLY и включено по умолчанию:
# ящик уже существует, владельца у него не было, на сервере ничего не меняется.
MAIL_RECONCILE_AUTO_LINK=true

# ─── SSH-туннель до почтового сервера (профиль mail-tunnel) ─────────────────
# Нужен, когда почтовый сервер закрыт наружу. Поднимается отдельно:
#   docker compose --profile mail-tunnel up -d mail-tunnel
# Перед первым запуском:
#   1. приватный ключ → infra/mail-tunnel/ssh/id_ed25519
#   2. ssh-keyscan -p <порт> <хост> > infra/mail-tunnel/ssh/known_hosts
# Проверка ключа хоста включена намеренно: по туннелю ходят почтовые пароли.
MAIL_TUNNEL_SSH_HOST=
MAIL_TUNNEL_SSH_PORT=22
MAIL_TUNNEL_SSH_USER=
# Адреса, как их видит сам ssh-хост (обычно он же и почтовый сервер).
MAIL_TUNNEL_REMOTE_IMAP_HOST=127.0.0.1
MAIL_TUNNEL_REMOTE_IMAP_PORT=993
MAIL_TUNNEL_REMOTE_SMTP_HOST=
MAIL_TUNNEL_REMOTE_SMTP_PORT=587
MAIL_TUNNEL_LOCAL_IMAP_PORT=1143
MAIL_TUNNEL_LOCAL_SMTP_PORT=1587

# ─── Наблюдаемость: Prometheus + Grafana ────────────────────────────────────
#
# Контур доступа: наружу смотрит ТОЛЬКО Grafana (nginx → /grafana/, вход по
# платформенному JWT). Prometheus, Loki, Flower и экспортеры живут во
# внутренней сети и портов на хост не публикуют — их публикация вынесена в
# docker-compose.dev.yml, то есть работает лишь локально.

# ОБЯЗАТЕЛЬНО. Без значения Grafana не стартует — и это намеренно: раньше
# здесь молча подставлялось admin/admin на панель со всеми метриками
# платформы. Локальный вход нужен только на случай, когда сломан JWT SSO.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# Метка стенда: уезжает в external_labels каждой серии. Разделяет данные,
# если несколько окружений когда-нибудь сведут в одно хранилище.
PROMETHEUS_ENV=production

# ── Доставка алертов ────────────────────────────────────────────────────────
# Telegram — основной канал: доходит мгновенно и не зависит от почты, которая
# работает на этой же платформе и в момент аварии может лежать сама.
# Бот заводится через @BotFather. Токен — секрет, поэтому живёт здесь.
GF_TELEGRAM_BOT_TOKEN=
#
# ⚠️ Chat id задаётся НЕ здесь, а литералом в
#    infra/logging/grafana-provisioning/alerting/contact_points.yml.
#    Причина: Grafana 10.4 переопределяет тип значения после подстановки
#    окружения, и числовой id (а Telegram выдаёт именно числовой) роняет
#    старт Grafana целиком. Ни кавычки, ни тег !!str не помогают — проверено.
#    Chat id не секрет, так что в конфиге ему место. Узнать свой:
#    @userinfobot для личного чата; для группы id отрицательный
#    (например -1001234567890).


# Email — второй независимый канал, включается ТОЛЬКО на severity=critical.
# Без GF_SMTP_* письма молча не уходят, поэтому Telegram и сделан основным.
ALERT_EMAIL_TO=
GF_SMTP_ENABLED=false
GF_SMTP_HOST=
GF_SMTP_USER=
GF_SMTP_PASSWORD=
GF_SMTP_FROM_ADDRESS=
GF_SMTP_SKIP_VERIFY=false

# ─── Where service-specific secrets live ────────────────────────────────────
# OAuth / Gmail / encryption  → services/email/.env       (.env.example shipped)
# Push notifications (FCM)    → services/messenger/.env   (.env.example shipped)
# S3 storage credentials      → services/media/.env       (.env.example shipped)
# WebRTC / SFU bitrates       → sfu/.env                  (.env.example shipped)
# Vite / frontend dev vars    → frontend/.env             (.env.example shipped)
