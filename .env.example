# ╔═══════════════════════════════════════════════════════════════════════════╗
# ║  Root .env.example — multi-service infra secrets only.                    ║
# ║  Docker Compose interpolates ${VAR} from .env into each service's         ║
# ║  `environment:` block. Service-specific secrets live in services/<n>/.env.║
# ║  Copy to .env and fill in real values.                                    ║
# ╚═══════════════════════════════════════════════════════════════════════════╝

# ─── Database (shared Postgres + PgBouncer; one schema per service) ─────────
DB_NAME=htqweb
DB_USER=htqweb
DB_PASSWORD=change-me
DB_HOST=db
DB_PORT=5432
# Host port used to expose Docker Postgres for local processes outside Docker
DB_HOST_PORT=55432

# ─── JWT (signed by user-service, validated by every other service) ─────────
# Must match across all services. user-service is the issuer.
JWT_SECRET=change-me-to-a-random-256-bit-secret

# ─── Service-to-service JWT (user-service → media-service for avatars, …) ──
SERVICE_JWT_SECRET=change-me-to-another-random-256-bit-secret

# ─── Object storage (S3 / MinIO) ────────────────────────────────────────────
# Manifesto: ONE microservice = ONE bucket. Adding a new storage-owning
# service? Add a new bucket here, propagate it via docker-compose.yml, and
# document the prefix layout in services/README.md (#object-storage).
#
# Dev defaults point at the MinIO container shipped in docker-compose.dev.yml.
# In production: replace S3_ENDPOINT with the real provider (AWS S3, Yandex
# Object Storage, etc.), set S3_USE_PATH_STYLE=false for AWS, and rotate
# S3_ACCESS_KEY / S3_SECRET_KEY out of dev defaults.
STORAGE_BACKEND=s3
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_USE_PATH_STYLE=true

# MinIO root login (= S3 keys above, so the existing dev volume stays valid)
# and web console URL surfaced in the admin panel.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_CONSOLE_URL=http://localhost:9001

# Per-service buckets — bootstrapped automatically by `minio-bootstrap` in
# docker-compose.dev.yml. In prod create them in your provider console first.
MEDIA_S3_BUCKET=htqweb-media
MESSENGER_S3_BUCKET=htqweb-messenger
CMS_S3_BUCKET=htqweb-cms
CONFERENCES_S3_BUCKET=htqweb-conferences

# HMAC secrets for short-lived signed URLs (used inside <img src> /
# <a download>). Rotate independently from JWT_SECRET.
ATTACHMENT_SIGNED_URL_SECRET=change-me-attachment-signed-secret
NEWS_SIGNED_URL_SECRET=change-me-news-signed-secret

# ─── MongoDB (HR documents NoSQL storage) ───────────────────────────────────
MONGO_USER=htqweb
MONGO_PASSWORD=change-me-mongo

# ─── AdminJS Panel ──────────────────────────────────────────────────────────
ADMINJS_EMAIL=admin@htq.local
ADMINJS_PASSWORD=admin

# ─── Конференция: SFU + QUIC-мост ───────────────────────────────────────────
# Публичный IP, который SFU кладёт в ICE-кандидаты. ОБЯЗАТЕЛЕН в проде:
# с wildcard listenIp и пустым announced контейнер намеренно падает на
# старте (иначе клиенты получают SDP с 0.0.0.0 и чёрное видео).
# В dev подставляется 127.0.0.1 — годится, пока браузер на той же машине.
WEBRTC_ANNOUNCED_IP=
WEBRTC_SERVER_PORT=44444
# Сигналинг требует платформенный JWT (тот же JWT_SECRET, что у Django).
# false — только для локальной отладки без бэкенда.
SFU_REQUIRE_AUTH=true
# TLS терминирует nginx, внутрь контейнера идёт ws:// — оставьте false.
SFU_REQUIRE_TLS=false
# Проверка Origin. При включении (false) задайте список:
# SFU_ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com
SFU_DISABLE_ORIGIN_CHECK=true
SFU_ALLOWED_ORIGINS=
# QUIC-сигналинг (webtransport, UDP :4433 — мимо nginx). Пусто = не
# анонсируем мост, фронт работает по WebSocket. В проде: https://<домен>:4433/sfu
# плюс живой сертификат домена:
# WT_CERT_FILE=/etc/letsencrypt/live/<домен>/fullchain.pem
# WT_KEY_FILE=/etc/letsencrypt/live/<домен>/privkey.pem
CONFERENCE_WT_URL=

# ─── Корпоративная почта (apps/mail) ────────────────────────────────────────
# Пока не заполнено — почтовый сервер НЕ подключён: ящик, созданный на сайте,
# останется только строкой в базе платформы. Раздел «Корпоративные ящики»
# честно предупреждает об этом баннером.
#
# Домен, в котором живут ящики (i.ivanov@<домен>). Без него POST
# /api/email/v1/mailboxes/ отвечает 500 "MAILCOW_DOMAIN not configured" —
# это и есть «невозможно добавить почтовый ящик».
#
# ГОЛЫЙ домен, без «@», без «https://», без пробела после «=»:
#   верно:    CORPORATE_MAIL_DOMAIN=htq.group
#   неверно:  @htq.group   https://mail.htq.group/   i.ivanov@htq.group
# Адрес веб-панели/API — это ДРУГАЯ переменная, MAILCOW_API_URL ниже.
# (Опечатки такого рода бэкенд чинит сам и пишет предупреждение в лог, но
# лучше задать сразу правильно — «mail.htq.group» и «htq.group» это разные
# домены, и угадать за вас он не может.)
CORPORATE_MAIL_DOMAIN=
# Историческое имя того же домена; если пусто — берётся CORPORATE_MAIL_DOMAIN.
MAILCOW_DOMAIN=
MAILCOW_DEFAULT_QUOTA_MB=1024

# Кто заводит ящики на сервере: auto | mailcow | imap | none
#   auto    — mailcow, если задан MAILCOW_API_URL+KEY; иначе imap, если задан
#             IMAP_HOST; иначе none (ничего наружу не вызывается).
#   mailcow — REST API Mailcow: ящик реально создаётся/архивируется/удаляется.
#   imap    — сервер без админ-API: ящик обязан существовать, платформа
#             проверяет учётку живым IMAP-логином и привязывает его.
#   none    — только локальная строка.
MAIL_PROVISIONER=auto

# ── Вариант A: Mailcow с REST API ──
# URL — с путём до API, БЕЗ завершающего слеша: https://mail.example.com/api/v1
# Ключ создаётся в панели Mailcow: Configuration → Access → API (нужен
# read-write; read-only хватит только на сверку, но не на создание ящиков).
MAILCOW_API_URL=
MAILCOW_API_KEY=

# ── Вариант B: свой почтовый сервер по IMAP/SMTP ──
# Напрямую по сети:
#   IMAP_HOST=mail.company.ru   IMAP_PORT=993   IMAP_SSL=true
#   SMTP_HOST=mail.company.ru   SMTP_PORT=587   SMTP_STARTTLS=true
# Через SSH-туннель (см. профиль mail-tunnel ниже) — шифрует сам SSH:
#   IMAP_HOST=mail-tunnel       IMAP_PORT=1143  IMAP_SSL=false
#   SMTP_HOST=mail-tunnel       SMTP_PORT=1587  SMTP_STARTTLS=false
IMAP_HOST=
IMAP_PORT=993
IMAP_SSL=true
IMAP_STARTTLS=false
# Нужно, только если хотите TLS ВНУТРИ туннеля: подключаемся к mail-tunnel, а
# сертификат проверяем по настоящему имени сервера.
IMAP_TLS_SERVER_HOSTNAME=
SMTP_HOST=
SMTP_PORT=587
SMTP_SSL=false
SMTP_STARTTLS=true

# Синхронизация писем. MAIL_SYNC_PUSH_FLAGS=true — прочитанное в платформе
# помечается \Seen и на сервере (вторая половина двусторонней синхронизации).
MAIL_SYNC_FOLDERS=INBOX,Sent
MAIL_SYNC_MAX_MESSAGES=200
MAIL_SYNC_PUSH_FLAGS=true
# Ежечасная сверка ящиков по умолчанию только пишет расхождения в лог;
# применяет их админ из UI. true = сводить автоматически (в обе стороны).
MAIL_RECONCILE_AUTO_APPLY=false

# ─── SSH-туннель до почтового сервера (профиль mail-tunnel) ─────────────────
# Нужен, когда почтовый сервер закрыт наружу. Поднимается отдельно:
#   docker compose --profile mail-tunnel up -d mail-tunnel
# Перед первым запуском:
#   1. приватный ключ → infra/mail-tunnel/ssh/id_ed25519
#   2. ssh-keyscan -p <порт> <хост> > infra/mail-tunnel/ssh/known_hosts
# Проверка ключа хоста включена намеренно: по туннелю ходят почтовые пароли.
MAIL_TUNNEL_SSH_HOST=
MAIL_TUNNEL_SSH_PORT=22
MAIL_TUNNEL_SSH_USER=
# Адреса, как их видит сам ssh-хост (обычно он же и почтовый сервер).
MAIL_TUNNEL_REMOTE_IMAP_HOST=127.0.0.1
MAIL_TUNNEL_REMOTE_IMAP_PORT=993
MAIL_TUNNEL_REMOTE_SMTP_HOST=
MAIL_TUNNEL_REMOTE_SMTP_PORT=587
MAIL_TUNNEL_LOCAL_IMAP_PORT=1143
MAIL_TUNNEL_LOCAL_SMTP_PORT=1587

# ─── Where service-specific secrets live ────────────────────────────────────
# OAuth / Gmail / encryption  → services/email/.env       (.env.example shipped)
# Push notifications (FCM)    → services/messenger/.env   (.env.example shipped)
# S3 storage credentials      → services/media/.env       (.env.example shipped)
# WebRTC / SFU bitrates       → sfu/.env                  (.env.example shipped)
# Vite / frontend dev vars    → frontend/.env             (.env.example shipped)
