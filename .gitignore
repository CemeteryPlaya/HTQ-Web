# ─── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/

# SQLite (legacy Django dev DB — retained as a guard against re-introducing it)
*.sqlite3

# collectstatic output. Появляется в рабочей копии, потому что dev-стек
# бинд-маунтит ./backend в контейнер (docker-compose.dev.yml), а entrypoint
# гоняет collectstatic при старте backend-web. Это сборочный артефакт.
backend/staticfiles/

# ─── Environment / Secrets ───────────────────────────────────────────────────
# Keep .env.example (template), ignore actual .env files with real secrets
.env
.env.production
.env.local
.env.*.local
# Шаблон — единственный .env-файл в репозитории. Раньше он был сначала
# заигнорен строкой `.env.example`, а потом возвращён `!`-строкой ниже:
# работало, но держалось на порядке строк, и перестановка молча выкинула бы
# шаблон из репозитория. Теперь его просто не игнорируют.
!frontend/.env.example

# ─── TLS Certificates ────────────────────────────────────────────────────────
# Local-dev TLS material — never commit private keys
infra/certs/
webtransport/certs/

# ─── Local tools cache ───────────────────────────────────────────────────────
# Per-machine binaries (ngrok, bore, etc.) — install via PATH instead
tools/

# ─── Django collectstatic output ─────────────────────────────────────────────
# STATIC_ROOT (settings/base.py) — rebuilt by docker-entrypoint.sh on every
# start, so the contents are a build artifact. .gitkeep stays tracked to keep
# the directory itself in the repo.
backend/staticfiles/*
!backend/staticfiles/.gitkeep

# ─── Frontend ────────────────────────────────────────────────────────────────
node_modules/
frontend/dist/
frontend/.env
**/dist/
# `**/.tsbuildinfo` НЕ работал: он требует, чтобы файл назывался ровно
# `.tsbuildinfo`, а tsc пишет `tsconfig.app.tsbuildinfo`.
#
# Сам файл лежал в git не из-за этого: рабочее правило есть в
# `frontend/.gitignore`, но игнорирование не действует на то, что уже попало
# в индекс, — кэш закоммитили 24.08.2026, и с тех пор он шумел в каждом
# коммите. Убран через `git rm --cached`; правило здесь нужно, чтобы он не
# вернулся из корня.
*.tsbuildinfo

# ─── Docker ──────────────────────────────────────────────────────────────────
# Nothing to ignore — docker-compose.yml and Dockerfiles are committed

# ─── IDE ─────────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
.qwen/

# ─── Sync clients ────────────────────────────────────────────────────────────
.stfolder/

# ─── Logs ────────────────────────────────────────────────────────────────────
*.log
logs/

# ─── pytest / coverage ───────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.claude

# ─── Brainstorming / planning artifacts (kept local) ──────────────────────────
docs/superpowers/*
# Exception: HR migration roadmap is tracked during the refactor (remove before deploy)
!docs/superpowers/HR-MIGRATION-ROADMAP.md
backups/

for tasks
.remember
.superpowers
.stignore
docs/lark-reference/
docs/audit-2026-04-28
requirementsNDPP.txt
# Локальные скрипты с боевыми доступами (тот же случай, что .env выше).
db-vps.ps1
.playwright-mcp
memory.md
prod-hotfix.patch
prod-hotfix.patch
docker-compose.override.yml
*.bak
db_schema.csv
table_data.csv
existing_models.py
