        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "node_memory_MemTotal_bytes",
          "refId": "B",
          "legendFormat": "всего"
        }
      ],
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "Свободно на файловых системах",
