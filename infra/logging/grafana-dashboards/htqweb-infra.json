      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "topk(12, sum by (name) (rate(container_cpu_usage_seconds_total{name!=\"\"}[$__rate_interval])) * 100)",
          "refId": "A",
          "legendFormat": "{{name}}"
        }
      ],
      "description": "cAdvisor. Полезно, когда хост нагружен, а виновник неочевиден.",
      "id": 9
    },
