        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "redis_connected_clients",
          "refId": "B",
          "legendFormat": "клиенты Redis"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "redis_memory_used_bytes / 1024 / 1024",
          "refId": "C",
          "legendFormat": "Redis, МБ"
        }
      ],
