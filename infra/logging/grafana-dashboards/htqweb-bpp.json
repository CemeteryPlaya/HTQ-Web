  "timezone": "",
  "annotations": {
    "list": []
  },
  "description": "Модуль «Бюджет, закупки и оплаты» (apps/bpp/metrics.py, задача A3.2). Считает Celery-beat раз в 60 с по каждой компании (метка company); пустая панель = метрики нет, а не ноль (см. apps/core/metrics.py). Итог ночной сверки «Задействовано» не пересчитывается каждую минуту: его пишет ночная задача (02:30) в настройку модуля committed_check_last (D-S3-4).",
  "templating": {
    "list": [
      {
        "name": "company",
        "label": "Компания",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(htqweb_bpp_requests_in_approval, company)",
        "query": { "query": "label_values(htqweb_bpp_requests_in_approval, company)", "refId": "company" },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": { "selected": true, "text": ["All"], "value": ["$__all"] },
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Заявки на закупку",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 },
      "collapsed": false,
      "panels": [],
      "id": 100
    },
    {
      "type": "stat",
      "title": "На согласовании",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 1, "w": 6, "h": 5 },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum without (company) (htqweb_bpp_requests_in_approval{company=~\"$company\"})",
          "refId": "A"
        }
      ],
      "description": "Заявки в статусе «На согласовании» (без технических заявок переноса из contracts). Справочная цифра, порога нет.",
      "id": 1
    },
    {
      "type": "stat",
      "title": "На этапе дольше 5 рабочих дней",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 6, "y": 1, "w": 6, "h": 5 },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum without (company) (htqweb_bpp_requests_in_approval_stale{company=~\"$company\"})",
          "refId": "A"
        }
      ],
      "description": "Заявки, чей ТЕКУЩИЙ этап согласования активирован больше 5 рабочих дней назад (Пн–Пт, без праздников). Правила нет намеренно: это очередь людей, её видно в ежедневной сводке «ждут вашего решения» — см. шапку rules.yml. Пустая панель при выключенном signoff.",
      "id": 2
    },
    {
      "type": "timeseries",
      "title": "Очередь согласования заявок",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 1, "w": 12, "h": 5 },
