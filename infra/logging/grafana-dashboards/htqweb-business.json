      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase({__name__=~\"htqweb_fallback_total|sfu_fallback_total\", expected=\"false\"}[24h]))",
          "refId": "A"
        }
      ],
