        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "topk(10, sum by (site) (rate({__name__=~\"htqweb_fallback_total|sfu_fallback_total\", expected=\"true\"}[5m])))",
          "refId": "A",
          "legendFormat": "{{site}}"
        }
      ],
      "id": 13
    },
    {
      "type": "stat",
      "title": "Подмен за сутки",
      "description": "Ноль здесь — не «метрика не работает», а «ничего не подменялось»: счётчик существует всегда, в отличие от бизнес-гейджей, которые при мёртвом сборщике не экспортируются вовсе. Celery-воркеры сюда не попадают (у них нет /metrics) — их ловит Loki-правило.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 38,
        "w": 6,
        "h": 5
