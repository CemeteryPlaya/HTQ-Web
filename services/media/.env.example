# ─── Service Identity ───────────────────────────────────────────────────────
SERVICE_NAME=media
SERVICE_PORT=8009
SERVICE_ENV=development

# ─── JWT Authentication (shared with user-service) ──────────────────────────
JWT_SECRET=change-me-to-a-random-256-bit-secret
JWT_ALGORITHM=HS256
JWT_ISSUER=htqweb-auth

# ─── Service-to-service JWT (must match user-service.SERVICE_JWT_SECRET) ────
SERVICE_JWT_SECRET=change-me-to-another-random-256-bit-secret
SERVICE_JWT_ALGORITHM=HS256

# ─── Database ───────────────────────────────────────────────────────────────
DB_HOST=pgbouncer
DB_PORT=5432
DB_NAME=htqweb
DB_USER=htqweb
DB_PASSWORD=change-me
DB_SCHEMA=media

# ─── Redis ──────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/4

# ─── Observability ──────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
LOG_LEVEL=INFO
AUDIT_LOG_RETENTION_DAYS=90

# ─── Storage backend: local | s3 ────────────────────────────────────────────
# Defaults are wired in docker-compose.yml from the root .env. Per the
# "1 service = 1 bucket" rule, this service owns ${MEDIA_S3_BUCKET}.
STORAGE_BACKEND=s3
MEDIA_ROOT=/app/data/media

# ─── S3 (only used when STORAGE_BACKEND=s3) ─────────────────────────────────
S3_BUCKET=htqweb-media
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_USE_PATH_STYLE=true
S3_PRESIGNED_URL_TTL=3600

# ─── Limits ─────────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=100
ALLOWED_MIME_TYPES=
