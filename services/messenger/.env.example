# ─── Service Identity ───────────────────────────────────────────────────────
SERVICE_NAME=messenger
SERVICE_PORT=8010
SERVICE_ENV=development

# ─── JWT Authentication (shared with user-service) ──────────────────────────
JWT_SECRET=change-me-to-a-random-256-bit-secret
JWT_ALGORITHM=HS256
JWT_ISSUER=htqweb-auth

# ─── Database ───────────────────────────────────────────────────────────────
DB_HOST=pgbouncer
DB_PORT=5432
DB_NAME=htqweb
DB_USER=htqweb
DB_PASSWORD=change-me
DB_SCHEMA=messenger

# ─── Redis (Socket.IO adapter + Dramatiq broker) ────────────────────────────
REDIS_URL=redis://redis:6379/3

# ─── Observability ──────────────────────────────────────────────────────────
LOG_LEVEL=INFO
AUDIT_LOG_RETENTION_DAYS=90

# ─── Attachments (legacy local dir — kept for the migration script that
#     backfills existing files into S3; new uploads always go to S3) ─────────
ATTACHMENT_DIR=/app/data/attachments

# ─── Object storage (S3 / MinIO) ────────────────────────────────────────────
# Per the "1 service = 1 bucket" rule (services/README.md). MinIO defaults
# come from root .env in dev; replace with real S3 endpoints in prod.
STORAGE_BACKEND=s3
S3_BUCKET=htqweb-messenger
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_USE_PATH_STYLE=true
S3_PRESIGNED_URL_TTL=3600

# Signed redirect URL embedded in <img src> / <a href>. Rotate independently
# from JWT_SECRET.
ATTACHMENT_SIGNED_URL_SECRET=change-me-attachment-signed-secret
ATTACHMENT_SIGNED_URL_TTL=3600

# Weekly room-history archive — Saturday 04:30 GMT+5 by default.
HISTORY_ARCHIVE_TIMEZONE=Asia/Almaty
HISTORY_ARCHIVE_CRON_DAY=sat
HISTORY_ARCHIVE_CRON_HOUR=4
HISTORY_ARCHIVE_CRON_MINUTE=30

# ─── Push Notifications (optional) ──────────────────────────────────────────
FCM_API_KEY=
APNS_CERT_PATH=
