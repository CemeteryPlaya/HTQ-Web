# ─── Service Identity ───────────────────────────────────────────────────────
SERVICE_NAME=user-identity
SERVICE_PORT=8005
SERVICE_ENV=development

# ─── JWT Authentication (this service is the JWT issuer) ────────────────────
JWT_SECRET=change-me-to-a-random-256-bit-secret
JWT_ALGORITHM=HS256
JWT_ISSUER=htqweb-auth

# ─── Database ───────────────────────────────────────────────────────────────
DB_HOST=pgbouncer
DB_PORT=5432
DB_NAME=htqweb
DB_USER=htqweb
DB_PASSWORD=change-me
DB_SCHEMA=auth

# ─── Redis ──────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── Observability ──────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=user-identity
LOG_LEVEL=INFO

# ─── Service-to-service JWT (signs internal calls to media-service etc.) ───
SERVICE_JWT_SECRET=change-me-to-another-random-256-bit-secret
SERVICE_JWT_ALGORITHM=HS256

# ─── Downstream services ───────────────────────────────────────────────────
MEDIA_SERVICE_URL=http://media-service:8009
EMAIL_SERVICE_URL=http://email-service:8011
