# ─── Service Identity ───────────────────────────────────────────────────────
SERVICE_NAME=email
SERVICE_PORT=8011
SERVICE_ENV=development

# ─── JWT Authentication (shared with user-service) ──────────────────────────
JWT_SECRET=change-me-to-a-random-256-bit-secret
JWT_ALGORITHM=HS256
JWT_ISSUER=htqweb-auth

# ─── Database ───────────────────────────────────────────────────────────────
DB_HOST=pgbouncer
DB_PORT=5432
DB_NAME=htqweb
DB_USER=htqweb
DB_PASSWORD=change-me
DB_SCHEMA=email

# ─── Redis ──────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/6

# ─── Observability ──────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ─── Crypto: AES-256-GCM key for OAuth refresh-token storage ────────────────
# Format: 64 hex characters (32 bytes).
# Generate: python -c "import os; print(os.urandom(32).hex())"
ENCRYPTION_KEY=

# ─── Google OAuth 2.0 (Gmail API — scope: gmail.send only) ──────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/email/oauth/callback/

# ─── Microsoft OAuth 2.0 (Graph API — scope: Mail.Send) ─────────────────────
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_OAUTH_REDIRECT_URI=http://localhost:8000/api/email/oauth/callback/
MICROSOFT_OAUTH_TENANT_ID=common

# ─── Legacy Gmail SMTP fallback (deprecated, will be removed) ───────────────
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# ─── Mailcow provisioning (mailbox CRUD on your domain) ─────────────────────
MAILCOW_API_URL=https://mail.yourdomain.com/api/v1
MAILCOW_API_KEY=
MAILCOW_DOMAIN=yourdomain.com
MAILCOW_DEFAULT_QUOTA_MB=1024

# ─── Service-to-service JWT (must match user-service.SERVICE_JWT_SECRET) ────
SERVICE_JWT_SECRET=change-me-to-another-random-256-bit-secret
SERVICE_JWT_ALGORITHM=HS256
