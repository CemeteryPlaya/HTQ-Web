# ─── Service Identity ───────────────────────────────────────────────────────
SERVICE_NAME=cms
SERVICE_PORT=8008
SERVICE_ENV=development

# ─── JWT Authentication ─────────────────────────────────────────────────────
JWT_SECRET=change-me-to-django-secret-key
JWT_ALGORITHM=HS256
JWT_ISSUER=htqweb-auth

# ─── Database ───────────────────────────────────────────────────────────────
DB_HOST=pgbouncer
DB_PORT=5432
DB_NAME=htqweb
DB_USER=htqweb
DB_PASSWORD=change-me
DB_SCHEMA=cms

# ─── Redis ──────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── Observability ─────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=cms
LOG_LEVEL=INFO

# ─── CMS-specific ──────────────────────────────────────────────────────────
CONFERENCE_CONFIG_PATH=app/data/conference.yaml
# TODO: set a real API key once the translation provider is chosen.
TRANSLATION_API_KEY=
TRANSLATION_PROVIDER=google
CONTACT_REQUEST_RATE_LIMIT=3/minute
EMAIL_SERVICE_URL=http://email-service:8011
AUDIT_LOG_RETENTION_DAYS=90

# ─── Object storage (S3 / MinIO) ───────────────────────────────────────────
# Per "1 service = 1 bucket" rule (services/README.md). MinIO defaults come
# from root .env in dev; replace with real S3 endpoints in prod.
STORAGE_BACKEND=s3
S3_BUCKET=htqweb-cms
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_USE_PATH_STYLE=true
S3_PRESIGNED_URL_TTL=3600

# Signed redirect URL for private news attachments (works in <a href>).
NEWS_SIGNED_URL_SECRET=change-me-news-signed-secret
NEWS_SIGNED_URL_TTL=3600

# Local-storage fallback when STORAGE_BACKEND=local.
CMS_LOCAL_STORAGE_DIR=/app/data/cms
