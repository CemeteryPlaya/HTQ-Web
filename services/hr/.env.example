# ─── Service Identity ───────────────────────────────────────────────────────
SERVICE_NAME=hr-service
SERVICE_PORT=8006
SERVICE_ENV=development

# ─── API ────────────────────────────────────────────────────────────────────
API_PREFIX=/api/hr/v1

# ─── JWT Authentication (shared with user-service) ──────────────────────────
JWT_SECRET=change-me-to-a-random-256-bit-secret
JWT_ALGORITHM=HS256
JWT_ISSUER=htqweb-auth

# ─── Database ───────────────────────────────────────────────────────────────
DB_HOST=pgbouncer
DB_PORT=5432
DB_NAME=htqweb
DB_USER=htqweb
DB_PASSWORD=change-me
DB_SCHEMA=public

# ─── Redis ──────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/1

# Downstream services
MEDIA_SERVICE_URL=http://media-service:8009

# ─── Observability ──────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=hr-service
LOG_LEVEL=INFO

# Google Cloud Translation Basic v2 (optional; enables EN org-chart payloads)
GOOGLE_TRANSLATE_API_KEY=
GOOGLE_TRANSLATE_API_BASE=https://translation.googleapis.com/language/translate/v2

# LibreTranslate fallback (optional, free when self-hosted)
# Example with docker-compose profile: http://libretranslate:5000
LIBRE_TRANSLATE_API_URL=
LIBRE_TRANSLATE_API_KEY=
