# ── Root build-context (post-shared-auth migration) ──
# Each service Dockerfile now builds with `context: .` (repo root) so it can
# COPY both `services/<name>/` and `libs/htqweb_auth/`. Exclude everything not
# needed by Python services to keep the context tarball small.
frontend/
sfu/
webtransport/
node_modules/
services/adminjs/
services/_template/
**/tests/__pycache__/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/htmlcov/
**/.coverage
**/coverage.xml
**/*.egg-info/
